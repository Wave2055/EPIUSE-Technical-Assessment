{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "AWS access key ID (ADR-0019)",
            "pattern": "/\\b(A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}\\b/"
          },
          {
            "name": "JWT signing key (ADR-0014)",
            "pattern": "/\\b(JWT_SECRET|JWT_SIGNING_KEY|REFRESH_TOKEN_SECRET|ACCESS_TOKEN_SECRET)\\s*[:=]\\s*[\"']?[A-Za-z0-9/+_=-]{12,}/i"
          },
          {
            "name": "DB URL with inline password",
            "pattern": "/\\bpostgres(ql)?:\\/\\/[^:\\s\"']+:[^@\\s\"']+@/i"
          },
          {
            "name": "Terraform literal secret (ADR-0018)",
            "pattern": "/\\b(db_password|master_password|rds_password|jwt_secret)\\s*=\\s*\"[^\"$]{8,}\"/i"
          },
          {
            "name": "PEM private key",
            "pattern": "/-----BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----/"
          }
        ]
      }
    }
  ]
}
