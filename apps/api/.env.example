# Copy to .env for local development. Never commit .env (ADR-0018).

# A PostgreSQL connection URL. For the database in the root docker-compose.yml, the user,
# password and database name are all `epiuse`, on localhost port 5432.
DATABASE_URL=

# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Local development runs over plain HTTP, so the refresh cookie cannot be Secure.
COOKIE_SECURE=false

# Optional: avatar uploads. Leave AVATAR_BUCKET empty to disable them (Gravatar still works).
AWS_REGION=af-south-1
AVATAR_BUCKET=
ASSET_BASE_URL=

# Used only by `pnpm db:seed` for the two starter logins (12+ characters each).
SEED_ADMIN_PASSWORD=
SEED_VIEWER_PASSWORD=
