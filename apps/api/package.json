{
  "name": "@epiuse/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS employee hierarchy API (ADR-0004)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/s3-presigned-post": "^3.1152.0",
    "@epiuse/shared": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "vitest": "^5.0.4"
  }
}
