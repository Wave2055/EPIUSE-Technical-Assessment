infra/**/.terraform/
infra/**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example

# Test and coverage output
coverage/
test-results/
playwright-report/
.playwright/

# Editor and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
.npmrc

# Generated Prisma client (rebuilt by `prisma generate` on install)
apps/api/src/generated/
infra/tfplan
