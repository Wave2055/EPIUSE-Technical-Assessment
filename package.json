{
  "name": "epiuse-employee-hierarchy",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud-hosted employee hierarchy management system \u2014 EPI-USE technical assessment",
  "author": "Jaitin",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @epiuse/shared build && pnpm --filter \"./apps/*\" build",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "pnpm --parallel --filter @epiuse/shared --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @epiuse/api dev",
    "dev:web": "pnpm --filter @epiuse/web dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm --filter @epiuse/api test:integration",
    "test:e2e": "pnpm --filter @epiuse/web test:e2e",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo *.tsbuildinfo && rm -rf node_modules",
    "scan:secrets": "secretlint \"**/*\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-pattern": "^13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "secretlint": "^13.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "pnpm": {
    "overrides": {}
  }
}
